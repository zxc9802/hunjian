      "html": "<section class=\"ds-editor-sheet\"><label class=\"ds-editor-label\" for=\"ds-script\">视频文案</label><textarea class=\"ds-editor-text\" id=\"ds-script\" placeholder=\"输入或粘贴完整文案。\" aria-describedby=\"ds-script-help\"></textarea><div class=\"ds-editor-footer\"><span id=\"ds-script-help\">按文案匹配真实素材，保留原意。</span><span>0 / 6000</span></div></section>",
      "css": ".ds-editor-sheet{font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;border:1px solid #cbd5c9;background:var(--paper,#fffefa);border-radius:12px;overflow:hidden;color:var(--ink,#20362f)}.ds-editor-label{display:block;padding:18px 20px 8px;font-size:14px;font-weight:600}.ds-editor-text{font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;box-sizing:border-box;display:block;resize:vertical;min-height:260px;width:100%;border:0;background:transparent;color:var(--ink,#20362f);font-size:15px;line-height:1.95;padding:12px 20px 20px;caret-color:var(--green,#245e47)}.ds-editor-text::placeholder{color:#69776b;opacity:1}.ds-editor-text:focus-visible{outline:2px solid var(--green,#245e47);outline-offset:-4px}.ds-editor-footer{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;border-top:1px solid #e6e9e1;font-size:11px;color:var(--muted,#536359);font-variant-numeric:tabular-nums}"
    },
