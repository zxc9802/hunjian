      "css": ".ds-button-primary{font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;font-size:14px;font-weight:600;min-height:44px;padding:11px 18px;display:inline-flex;justify-content:center;align-items:center;gap:9px;border:1px solid transparent;border-radius:8px;cursor:pointer;transition:background .18s ease-out,color .18s ease-out;background:var(--green,#245e47);color:var(--paper,#fffefa)}.ds-button-primary:hover:not(:disabled){background:var(--green-hover,#174831)}.ds-button-primary:active:not(:disabled){background:#103a29}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}.ds-button-primary:focus-visible{outline:2px solid var(--green,#245e47);outline-offset:4px}@media(prefers-reduced-motion:reduce){button{transition:none!important}}"
    },
